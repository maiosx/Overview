{
  "schemaVersion": 1,
  "id": "io.github.overview",
  "name": "Overview",
  "version": "1.1.4",
  "author": "maiosx",
  "license": "MIT",
  "description": "Fullscreen file search with a column card layout — Space to pin, Enter to open.",
  "kinds": ["overlay", "service", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Overlay.qml",
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Overview",
    "category": "Tools",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
